# ============================================================================
#  RovoConnecter — 集中設定範本。複製為 .env 後填入真實值：
#    cp .env.example .env
#  .env 不會進版控（見 .gitignore）。
# ============================================================================

# ── 1) Forge CLI 認證 ───────────────────────────────────────────────────────
FORGE_EMAIL="you@example.com"
FORGE_API_TOKEN=""        # Atlassian API token

# ── 2) 部署目標站臺 ─────────────────────────────────────────────────────────
FORGE_SITE="your-site.atlassian.net"
FORGE_PRODUCT="jira"

# ── 3) CSV 資料來源（填進 Connected apps 的 connector 設定表單）───────────────
CSV_URL="https://example.com/path/to/data.csv"
CSV_ID_COLUMN="id"
CSV_TITLE_COLUMN="title"
CSV_URL_COLUMN="url"
CSV_BODY_COLUMN="description"
CSV_UPDATED_AT_COLUMN="updated_at"
